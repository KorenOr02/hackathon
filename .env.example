# Create a fresh API key in Dial, then copy this file to .env.local.
DIAL_API_KEY=sk_live_your_key_here

# Optional. When omitted, Swaper uses the first number returned by Dial.
DIAL_FROM_NUMBER_ID=pn_your_number_id

# Optional. Defaults to https://getdial.ai.
# DIAL_BASE_URL=https://getdial.ai

# Provider numbers. Swaper only calls providers with configured numbers.
# During testing, all providers fall back to this shared destination while
# preserving a different provider-specific prompt for every call.
DIAL_TEST_PROVIDER_NUMBER=+972558838259
CELLCOM_PHONE_NUMBER=+972558838259
PARTNER_PHONE_NUMBER=
PELEPHONE_PHONE_NUMBER=

# Customer number that receives the final WhatsApp summary.
CUSTOMER_WHATSAPP_NUMBER=
